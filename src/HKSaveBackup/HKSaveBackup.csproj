<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyVersion>$(ModVersion)</AssemblyVersion>
    <FileVersion>$(ModVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HKSaveBackup.Core\HKSaveBackup.Core.csproj" />
  </ItemGroup>

  <!-- Game reference assemblies. Private=false: never copy game DLLs to output. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(HollowKnightRefs)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_Assembly-CSharp">
      <HintPath>$(HollowKnightRefs)\MMHOOK_Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(HollowKnightRefs)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Death-salvage prompt: IMGUI for the overlay, InputLegacy for keyboard polling. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(HollowKnightRefs)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Convenience: copy the built mod into the game's Mods folder when InstallToGame=true (set in local.props). -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="'$(InstallToGame)' == 'true' And Exists('$(HollowKnightRefs)\Mods')">
    <ItemGroup>
      <ModFiles Include="$(TargetDir)HKSaveBackup.dll;$(TargetDir)HKSaveBackup.Core.dll;$(TargetDir)HKSaveBackup.pdb;$(TargetDir)HKSaveBackup.Core.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(HollowKnightRefs)\Mods\HKSaveBackup" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="HKSaveBackup installed to $(HollowKnightRefs)\Mods\HKSaveBackup" />
  </Target>
</Project>
